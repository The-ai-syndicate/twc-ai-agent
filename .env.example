# ============================================================================
# TWC AI Assistant - environment variables
# Copy to .env.local and fill in. NEVER commit .env.local or real secrets.
# ============================================================================

# --- Demo mode (true = mock OTP accepts 123456, verbose logging, no real SMS)
DEMO_MODE=true

# --- Supabase (Postgres + Auth + Storage + Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents
# Direct Postgres connection string for migration/seed scripts (server-side only).
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Pinecone (approved, non-personal knowledge base only)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=twc-kb
PINECONE_NAMESPACE=approved
# Embedding model id used at ingest + query time (multilingual)
PINECONE_EMBED_MODEL=multilingual-e5-large

# --- LLM (chat)
# Provider: 'deepseek' (OpenAI-compatible) or 'anthropic'
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=your-anthropic-key

# --- OCR (ocr.space) - read uploaded documents server-side only
OCR_SPACE_API_KEY=your-ocr-space-key

# --- Voice / TTS (AssemblyAI)
TTS_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your-assemblyai-key
ASSEMBLYAI_TTS_VOICE=scott
DEEPGRAM_API_KEY=your-deepgram-key

# --- OTP / SMS provider (mock in dev; logs code)
OTP_PROVIDER=mock
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SENDER=TWC

# --- Retention / limits (config)
RETENTION_CONVERSATION_DAYS=90
RETENTION_DOCUMENT_DAYS=7
RETENTION_AUDIT_MONTHS=12

# --- App
NEXT_PUBLIC_APP_NAME=TWC Assistant
